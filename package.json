{
  "name": "dsh-global-prompt-and-compress",
  "description": "DSH 设置插件：管理全局与各工作区 AGENTS.md、身份/人设注入、结果通知。Global and per-workspace AGENTS.md editor, identity/persona injection, and result notifications for DeepSeek Harness. 附带:会话压缩按钮等基础小工具(收纳区)。",
  "version": "0.2.2",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@git.ptrel.cc.cd:52222/ptrel1/dsh1-plugins.git",
    "directory": "plugins/dsh-global-prompt"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/core": "./lib/core.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "dsh": ">=0.1.1-rc.1",
    "node": ">=20.0.0"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "mirror": {
    "note": "对外发布出口（GitHub）。本插件开发维护在此 monorepo，改动须两侧同步推送。",
    "url": "git+https://github.com/ptrel1/dsh-global-prompt.git"
  }
}
